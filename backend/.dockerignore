# Files Docker should NOT copy into the build. Leaving them out keeps
# builds fast and stops leftovers from your PC (old compiled files,
# editor settings) from sneaking into the image.

# Compiled output from local builds — the image compiles its own fresh copy
**/bin/
**/obj/

# Tests run on your PC and in CI, not inside the production image
tests/

# Local-only setup
docker-compose.yml
**/*.user
.vs/
.vscode/
.idea/
